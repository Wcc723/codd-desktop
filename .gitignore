.DS_Store
.build*/
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.swiftpm/
Packages/*/.build*/
# local Claude Code session state
.claude/scheduled_tasks.lock
.claude/settings.local.json
# generated by XcodeGen from project.yml / Spikes/project.yml (run `xcodegen generate`)
*.xcodeproj/
# agent test logs
.tlogs/
# secrets and signing material (an exported certificate, a notarytool API key, local env files)
.env*
*.p12
*.pfx
*.cer
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
# release output that may land outside build/ (archives, disk images, zips at the root, logs)
*.xcarchive
*.dmg
/*.zip
*.log
# Claude Code's per-user files: a project-scope MCP config would carry CODD's live token
.mcp.json
CLAUDE.local.md
